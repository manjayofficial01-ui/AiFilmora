# Dependencies
node_modules/

# Build output (electron-builder, 800MB+ exes — rebuild with `npm run dist`)
dist/

# Stale duplicate of the Filmora dump (1.6GB). Canonical folder is `assets/`.
asset/

# Filmora runtime binaries — not loadable in a browser, never fetched by js/
# (614 DLLs, EXEs, 50MB+ .rcc skins, CEF blobs). Keeps the repo <300MB.
*.dll
*.exe
*.rcc
*.pak
*.bin
*.dat
*.ax
*.db
*.sqldb
*.wfx
*.skin

# Filmora-only dirs that the web app never fetches (translations, logs, CEF/Qt runtimes)
assets/Lang/
assets/log/
assets/cefresources/
assets/swiftshader/
assets/imageformats/
assets/platforms/
assets/DecPlugins/
assets/ImagePlugins/
assets/vlcPlugins/
assets/PlugIns/
log/

# Logs
*.log
el-err.log
el-out.log
dist-build*.log

# Playwright / verification screenshots (regenerated by verify-*.cjs)
output-*.png
rail-*.png
media-*.png

# Editor / OS / tooling
.playwright-cli/
.workbuddy-ai/
index.bak.html
tmp-*.cjs
.vscode/
.DS_Store
Thumbs.db
